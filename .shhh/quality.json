{
  "max_parallel": 1,
  "on_close": "default",
  "suites": {
    "default": {
      "timeout_seconds": 600,
      "require_containment": true,
      "allow_write": true,
      "checks": [
        {
          "name": "test",
          "exe": "make",
          "args": [
            "test"
          ]
        },
        {
          "name": "vet",
          "exe": "make",
          "args": [
            "vet"
          ]
        },
        {
          "name": "lint",
          "exe": "make",
          "args": [
            "lint"
          ]
        },
        {
          "name": "format",
          "exe": "make",
          "args": [
            "fmt-check"
          ]
        },
        {
          "name": "docs",
          "exe": "make",
          "args": [
            "docs-check"
          ]
        }
      ]
    },
    "tui": {
      "timeout_seconds": 300,
      "require_containment": true,
      "allow_write": true,
      "checks": [
        {
          "name": "tmux",
          "exe": "tmux",
          "args": [
            "-V"
          ]
        },
        {
          "name": "python3",
          "exe": "python3",
          "args": [
            "--version"
          ]
        },
        {
          "name": "smoke",
          "exe": "make",
          "args": [
            "tui-shot",
            "SCENE=smoke"
          ]
        }
      ]
    },
    "fast": {
      "timeout_seconds": 120,
      "require_containment": true,
      "checks": [
        {
          "name": "vet",
          "exe": "make",
          "args": [
            "vet"
          ]
        },
        {
          "name": "format",
          "exe": "make",
          "args": [
            "fmt-check"
          ]
        },
        {
          "name": "docs",
          "exe": "make",
          "args": [
            "docs-check"
          ]
        }
      ]
    }
  }
}
