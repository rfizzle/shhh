{
  "max_parallel": 1,
  "on_close": "default",
  "suites": {
    "default": {
      "timeout_seconds": 600,
      "require_containment": true,
      "checks": [
        { "name": "test", "exe": "make", "args": ["test-hermetic"] },
        { "name": "vet", "exe": "make", "args": ["vet-hermetic"] },
        { "name": "lint", "exe": "make", "args": ["lint-hermetic"] },
        { "name": "format", "exe": "make", "args": ["fmt-check-hermetic"] },
        { "name": "docs", "exe": "make", "args": ["docs-check-hermetic"] }
      ]
    },
    "fast": {
      "timeout_seconds": 120,
      "require_containment": true,
      "checks": [
        { "name": "vet", "exe": "make", "args": ["vet-hermetic"] },
        { "name": "format", "exe": "make", "args": ["fmt-check-hermetic"] },
        { "name": "docs", "exe": "make", "args": ["docs-check-hermetic"] }
      ]
    }
  }
}
